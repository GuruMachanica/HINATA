# HINATA — environment configuration (copy to .env and adjust)
# All settings have sane defaults; everything runs 100% local.

# --- Brain (Ollama) ---
# HINATA_MODEL_ENDPOINT=http://127.0.0.1:11434/v1
# HINATA_MODEL_NAME=hinata-omni       # Qwen3-VL-2B-Thinking abliterated (text + vision + thinking)
# HINATA_VISION_MODEL=hinata-omni     # same model — one brain for everything
# HINATA_MODEL_KEY=ollama

# --- Agentic tools ---
# HINATA_AGENTIC=1
# HINATA_MAX_TOOL_ROUNDS=4

# --- Streaming speech (sentence-chunked TTS while generating) ---
# HINATA_STREAM=1
# HINATA_STREAM_MIN_CHARS=40

# --- Proactivity ---
# HINATA_PROACTIVE=1
# HINATA_PROACTIVE_INTERVAL=600

# --- Server ---
# HINATA_PORT=8080
# HINATA_LOG_LEVEL=INFO
# HINATA_AUTH_TOKEN=            # set a token to lock the WS/REST API down
